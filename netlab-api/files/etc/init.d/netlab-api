#!/bin/sh /etc/rc.common

# procd service that runs the netlab REST API (Node.js).

START=95
STOP=11
USE_PROCD=1

PROG=/usr/bin/node
APP_DIR=/usr/lib/netlab-api
APP=$APP_DIR/server.js

# Override with `uci`-style env if desired; defaults match the app.
NETLAB_API_HOST="${NETLAB_API_HOST:-0.0.0.0}"
NETLAB_API_PORT="${NETLAB_API_PORT:-8080}"

start_service() {
	procd_open_instance
	procd_set_param command "$PROG" "$APP"
	procd_set_param env \
		NETLAB_API_HOST="$NETLAB_API_HOST" \
		NETLAB_API_PORT="$NETLAB_API_PORT"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
